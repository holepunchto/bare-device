{
  "name": "bare-device",
  "version": "0.0.0",
  "description": "Cross-platform device management for Android and iOS",
  "exports": {
    ".": "./index.js",
    "./android": "./android.js",
    "./ios": "./ios.js",
    "./package": "./package.json"
  },
  "bin": {
