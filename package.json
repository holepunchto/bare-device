  "dependencies": {
    "bare-device-android": "file:../bare-device-android",
    "bare-device-ios": "file:../bare-device-ios"
  },
  "devDependencies": {
    "lunte": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0"
  }
}
